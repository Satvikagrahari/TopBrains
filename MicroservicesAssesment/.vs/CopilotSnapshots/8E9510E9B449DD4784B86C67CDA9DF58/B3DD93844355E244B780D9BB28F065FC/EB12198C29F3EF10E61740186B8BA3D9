using System.Security.Cryptography;
using System.Text;
using Microsoft.Extensions.Configuration;
using Razorpay.Api;
using PaymentService.Application.DTOs;
using PaymentService.Application.Interfaces;
using PaymentService.Domain.Entities;
using PaymentService.Domain.Interfaces;
using BuildingBlocks.SharedKernel.Enums;

namespace PaymentService.Infrastructure.Services;

public class RazorpayPaymentService : IPaymentService
{
    private readonly IPaymentRepository _paymentRepo;
    private readonly IConfiguration _config;

    public RazorpayPaymentService(IPaymentRepository paymentRepo, IConfiguration config)
    {
        _paymentRepo = paymentRepo;
        _config = config;
    }

    public async Task<PaymentResponseDto> InitiatePaymentAsync(string userId, PaymentRequestDto dto)
    {
        // COD - just record it
        if (dto.Method == "COD")
        {
            var codPayment = new Payment
            {
                OrderId = dto.OrderId,
                UserId = userId,
                Amount = dto.Amount,
                Method = "COD",
                Status = PaymentStatus.Pending,
                Currency = dto.Currency
            };
            var saved = await _paymentRepo.CreateAsync(codPayment);
            return new PaymentResponseDto
            {
                PaymentId = saved.Id,
                OrderId = saved.OrderId,
                Amount = saved.Amount,
                Status = saved.Status.ToString(),
                CreatedAt = saved.CreatedAt
            };
        }

        // Razorpay for Card/UPI
        var keyId = _config["Razorpay:KeyId"];
        var keySecret = _config["Razorpay:KeySecret"];

        var client = new RazorpayClient(keyId, keySecret);

        var options = new Dictionary<string, object>
        {
            { "amount", (int)(dto.Amount * 100) }, // paise
            { "currency", dto.Currency },
            { "receipt", $"order_{dto.OrderId}" }
        };

        var rzpOrder = client.Order.Create(options);
        var rzpOrderId = rzpOrder["id"].ToString();

        var payment = new Payment
        {
            OrderId = dto.OrderId,
            UserId = userId,
            Amount = dto.Amount,
            Method = dto.Method,
            Currency = dto.Currency,
            Status = PaymentStatus.Pending,
            RazorpayOrderId = rzpOrderId
        };

        var created = await _paymentRepo.CreateAsync(payment);
        return new PaymentResponseDto
        {
            PaymentId = created.Id,
            OrderId = created.OrderId,
            Amount = created.Amount,
            Status = created.Status.ToString(),
            RazorpayOrderId = rzpOrderId,
            KeyId = keyId,
            CreatedAt = created.CreatedAt
        };
    }

    public async Task<bool> VerifyPaymentAsync(string razorpayOrderId, VerifyPaymentDto dto)
    {
        // Verify HMAC signature
        var keySecret = _config["Razorpay:KeySecret"]!;
        var payload = $"{dto.RazorpayOrderId}|{dto.RazorpayPaymentId}";
        using var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(keySecret));
        var computedHash = hmac.ComputeHash(Encoding.UTF8.GetBytes(payload));
        var computedSignature = BitConverter.ToString(computedHash).Replace("-", "").ToLower();

        var payment = await _paymentRepo.GetByOrderIdAsync(Guid.Empty); // find by razorpay order id
        // Get all payments and find by razorpay order id
        var allPayments = (await _paymentRepo.GetByUserIdAsync("")).ToList(); // workaround

        if (computedSignature != dto.RazorpaySignature)
        {
            return false;
        }

        return true;
    }

    public async Task<PaymentResponseDto?> GetByOrderIdAsync(Guid orderId)
    {
        var payment = await _paymentRepo.GetByOrderIdAsync(orderId);
        if (payment == null) return null;
        return Map(payment);
    }

    public async Task<IEnumerable<PaymentResponseDto>> GetMyPaymentsAsync(string userId)
    {
        var payments = await _paymentRepo.GetByUserIdAsync(userId);
        return payments.Select(Map);
    }

    private static PaymentResponseDto Map(Payment p) => new()
    {
        PaymentId = p.Id,
        OrderId = p.OrderId,
        Amount = p.Amount,
        Status = p.Status.ToString(),
        RazorpayOrderId = p.RazorpayOrderId,
        CreatedAt = p.CreatedAt
    };
}